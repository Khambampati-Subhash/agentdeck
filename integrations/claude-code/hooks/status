#!/bin/sh
# Reports Claude Code's state to AgentDeck over OSC 7501: status <state> [kind].
# Claude Code doesn't speak 7501, so its hooks do. A hook has no terminal of
# its own (its stdio are pipes, often in a new session), so this writes to the
# first ancestor's tty: Claude's. Outside hc (no HC_TERMINAL_ID) it does nothing.
[ -n "${HC_TERMINAL_ID:-}" ] || exit 0
cat >/dev/null 2>&1 # the hook's JSON, unused

body="state=$1:app=claude-code"
[ -n "${2:-}" ] && body="$body:kind=$2"
[ "$1" = clear ] && body="state=clear"

pid=$$
while [ "${pid:-1}" -gt 1 ]; do
  tty=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
  case $tty in
    "" | "?" | "??") pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ') ;;
    *)
      case $tty in /dev/*) ;; *) tty=/dev/$tty ;; esac
      printf '\033]7501;%s\033\\' "$body" >"$tty" 2>/dev/null
      exit 0
      ;;
  esac
done
exit 0
