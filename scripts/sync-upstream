#!/usr/bin/env python3
"""Syncs upstream (herdr-app or herdr-core) into app/ or core/.

Usage:
    sync-upstream pull <app|core> [ref]
    sync-upstream check <app|core>

`pull` fetches from upstream and merges. On conflict, lists the files and exits.
`check` prints added lines to review, then runs offline/names checks and the suite.
"""
import argparse
import os
import re
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(description="Sync upstream into a half")
    parser.add_argument("command", choices=["pull", "check"], help="pull or check")
    parser.add_argument("half", choices=["app", "core"], help="app or core")
    parser.add_argument("ref", nargs="?", default="master", help="upstream ref (default: master)")
    args = parser.parse_args()

    # Work from repo root
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    os.chdir(root)

    if args.command == "pull":
        return pull(args.half, args.ref)
    else:
        return check(args.half)


def pull(half, ref):
    """Fetch and merge upstream into the half."""
    # Check if on main
    current_branch = subprocess.run(
        ["git", "rev-parse", "--abbrev-ref", "HEAD"],
        capture_output=True, text=True, check=True
    ).stdout.strip()

    if current_branch == "main":
        print("refuse to sync on main", file=sys.stderr)
        return 2

    # Check if tree is dirty
    status_output = subprocess.run(
        ["git", "status", "--porcelain", "--untracked-files=no"],
        capture_output=True, text=True, check=True
    ).stdout

    if status_output.strip():
        print("working tree has staged or modified files", file=sys.stderr)
        return 2

    # Remote name
    remote_name = f"upstream-{half}"

    # Add remote if missing
    remotes = subprocess.run(
        ["git", "remote"],
        capture_output=True, text=True, check=True
    ).stdout.splitlines()

    if remote_name not in remotes:
        upstream_url = os.environ.get("SYNC_UPSTREAM_URL")
        if not upstream_url:
            upstream_url = f"https://github.com/herdrdev/herdr-{half}.git"
        subprocess.run(
            ["git", "remote", "add", remote_name, upstream_url],
            check=True
        )

    # Fetch
    subprocess.run(
        ["git", "fetch", "--no-tags", remote_name, ref],
        check=True
    )

    # Get the short SHA of what we're merging
    upstream_sha = subprocess.run(
        ["git", "rev-parse", "--short", "FETCH_HEAD"],
        capture_output=True, text=True, check=True
    ).stdout.strip()

    # Merge message
    merge_msg = f"repo: sync {half} with upstream {upstream_sha}"

    # Attempt the merge
    merge_result = subprocess.run(
        ["git", "subtree", "merge", "--prefix=" + half, "FETCH_HEAD", "-m", merge_msg],
        capture_output=True, text=True
    )

    if merge_result.returncode != 0:
        # Check for conflicts
        conflicts_output = subprocess.run(
            ["git", "diff", "--name-only", "--diff-filter=U"],
            capture_output=True, text=True, check=True
        ).stdout.strip()

        if conflicts_output:
            print("conflicts:")
            for path in conflicts_output.splitlines():
                print(path)
            print(f"resolve them (docs/upstream.md#conflict-rules), commit, then: scripts/sync-upstream check {half}")
            return 1
        else:
            # Merge failed without conflicts
            print(merge_result.stderr, file=sys.stderr)
            return 1

    # Success: run check
    return check(half)


def check(half):
    """Check added lines and run guards."""
    # Find the base: first parent of the newest sync commit
    log_output = subprocess.run(
        ["git", "log", "--format=%H %s", "--all"],
        capture_output=True, text=True, check=True
    ).stdout

    sync_pattern = re.compile(rf"^([0-9a-f]+) repo: sync {half} with upstream")
    sync_commit = None
    for line in log_output.splitlines():
        match = sync_pattern.match(line)
        if match:
            sync_commit = match.group(1)
            break

    if not sync_commit:
        print(f'no commit with subject "repo: sync {half} with upstream" found', file=sys.stderr)
        return 2

    # Get the first parent of the sync commit
    base = subprocess.run(
        ["git", "rev-parse", sync_commit + "^1"],
        capture_output=True, text=True, check=True
    ).stdout.strip()

    # Get added lines in the half
    diff_output = subprocess.run(
        ["git", "diff", f"{base}..HEAD", "--", half],
        capture_output=True, text=True, check=True
    ).stdout

    # Filter for lines matching the patterns
    patterns = [
        r"herdr\.dev",
        r"https?://",
        r"reqwest",
        r"curl",
        r"telemetry",
        r"Herdr",
        r"herdr-app ",
        r"\bhc ",
    ]
    combined_pattern = re.compile("|".join(patterns))

    print("added lines to review:")
    current_file = None
    for line in diff_output.splitlines():
        if line.startswith("+++"):
            # Extract file path
            path = line[6:]  # Skip "+++ b/"
            current_file = path
        elif line.startswith("+") and not line.startswith("+++"):
            # This is an added line
            content = line[1:]  # Skip the "+"
            if combined_pattern.search(content):
                print(f"{current_file}: {content}")

    # Run check-offline
    result = subprocess.run(["scripts/check-offline"])
    if result.returncode != 0:
        return result.returncode

    # Run check-names
    result = subprocess.run(["scripts/check-names"])
    if result.returncode != 0:
        return result.returncode

    # Run the suite (unless skipped)
    if os.environ.get("SYNC_UPSTREAM_SKIP_SUITES") == "1":
        return 0

    if half == "core":
        result = subprocess.run(["sh", "-c", "cd core && just check"])
    else:
        result = subprocess.run(["sh", "-c", "cd app && just test && just docs-check"])

    return result.returncode


if __name__ == "__main__":
    sys.exit(main())
